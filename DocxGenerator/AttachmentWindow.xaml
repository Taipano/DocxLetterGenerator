<Window x:Class="DocxLetterGenerator.AttachmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование приложения" Height="500" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

   
        <Label Content="Заголовок приложения:" Grid.Row="0" Grid.Column="0" 
               Margin="0,8,0,0" FontWeight="SemiBold" VerticalAlignment="Top"/>
        <TextBox x:Name="txtTitle" Grid.Row="0" Grid.Column="1" 
                 Margin="8,8,0,0" Height="35" VerticalContentAlignment="Center"
                 FontSize="13"/>

 
        <Label Content="Текст приложения:" Grid.Row="1" Grid.Column="0" 
               Margin="0,8,8,0" FontWeight="SemiBold" VerticalAlignment="Top"/>
        <TextBox x:Name="txtContent" Grid.Row="1" Grid.Column="1" 
                 Margin="8,8,0,0" AcceptsReturn="True" TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 MinHeight="250" FontSize="12" FontFamily="Consolas"/>

  
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Width="90" Height="35" Click="OkButton_Click" 
                    IsDefault="True" FontWeight="SemiBold" Background="#FF4CAF50" 
                    Foreground="White" Margin="0,0,8,0"/>
            <Button Content="Отмена" Width="90" Height="35" Click="CancelButton_Click" 
                    IsCancel="True" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>